# This file must never contain real credentials. Copy values into environment variables or a local untracked config.
# Template only — do not commit real secrets. Prefer setting the same keys via .env (see repo root .env.example).

spring:
  profiles:
    active: dev
  datasource:
    # Dev (application-dev.yml): jdbc:mysql://${DB_HOST:}:${DB_PORT:}/${DB_NAME:}?...
    # Prod (application-prod.yml): url: ${DB_URL}
    # Env vars used for datasource: DB_HOST, DB_PORT, DB_NAME, DB_URL, DB_USERNAME, DB_PASSWORD
    username: ${DB_USERNAME:}
    password: ${DB_PASSWORD:}

app:
  exchange-rate:
    connect-timeout-ms: 5000
    read-timeout-ms: 10000
    # TianAPI key for GET https://apis.tianapi.com/fxrate/index
    tianapi-key: ${TIANAPI_EXCHANGE_KEY:}

jwt:
  secret: ${JWT_SECRET:}
  expiration-ms: ${JWT_EXPIRATION_MS:86400000}
