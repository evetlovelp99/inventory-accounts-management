# Backend — database (dev profile)
# MySQL host used when spring.profiles.active=dev
DB_HOST=
# MySQL port used when spring.profiles.active=dev
DB_PORT=
# MySQL database name used when spring.profiles.active=dev
DB_NAME=
# MySQL username (required in prod; optional in dev with default root)
DB_USERNAME=
# MySQL password (required; empty default in dev so missing env fails closed)
DB_PASSWORD=

# Backend — database (prod profile)
# Full JDBC URL required when spring.profiles.active=prod
DB_URL=

# Backend — JWT
# HMAC signing secret for JWT (required; empty default in shared application.yml)
JWT_SECRET=
# Token lifetime in milliseconds (optional; defaults to 86400000)
JWT_EXPIRATION_MS=

# Backend — exchange rate provider
# TianAPI key for USD/CNY mid-rate lookup (optional; empty disables auto rate)
TIANAPI_EXCHANGE_KEY=

# Frontend — API base URL for Vite (optional; defaults to http://localhost:8080/api in DEV)
VITE_API_BASE_URL=
